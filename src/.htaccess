# src/.htaccess

<IfModule mod_rewrite.c>
  RewriteEngine On

  # API-Anfragen werden vom Webserver/Reverse-Proxy verarbeitet und dürfen
  # nicht auf die Angular index.html umgeschrieben werden.
  RewriteRule ^api(?:/|$) - [L]

  # Vorhandene Dateien und Verzeichnisse unverändert ausliefern.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Angular-Routen wie /portfolio oder /projects/intranet auf die SPA routen.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Framing nur innerhalb der eigenen Domain erlauben (Clickjacking-Schutz).
  Header always set X-Frame-Options "SAMEORIGIN"

  # CSP-Basis ohne Einschraenkung der vorhandenen Inline-Scripts und -Styles.
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"

  # HSTS zunaechst nur fuer den aktuellen Host und 24 Stunden testen.
  Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on'"

  <FilesMatch "\.(?:js|css)$">
    # Angular-Bundles sind gehasht; statische Studies behalten feste Dateinamen.
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} !~ m#^/design-studies/#"
    Header set Cache-Control "no-cache, must-revalidate" "expr=%{REQUEST_URI} =~ m#^/design-studies/#"
  </FilesMatch>

  <FilesMatch "\.(?:woff2|webp|avif|png|jpe?g|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
